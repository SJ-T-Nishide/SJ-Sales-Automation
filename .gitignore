# AI経営シグナルシステム - Git除外設定

# ===========================
# 機密情報・認証情報
# ===========================

# 環境変数
.env
scripts/.env

# Google Cloud サービスアカウントキー
*.json
!package.json
!package-lock.json
!**/appsscript.json
!higashare-ext/manifest.json

# APIキー
*_api_key*
*_credentials*

# ===========================
# Python
# ===========================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# ===========================
# Node.js (GAS開発用)
# ===========================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===========================
# IDEs
# ===========================

# VSCode
.vscode/
*.code-workspace

